# Enforces docs/citation_and_figure_policy.md section 6. Force-adding anything
# matched here is a policy breach, not a workaround.

# PDFs and article full text
*.pdf
*.epub

# Figures and extracted images
*.png
*.jpg
*.jpeg
*.gif
*.tif
*.tiff
*.bmp
*.webp
*.svg
literature/figures/

# DICOM and other medical imaging
*.dcm
*.dicom
*.nii
*.nii.gz
*.mha
*.mhd
*.nrrd
data/

# Generated reports and audit artefacts
reports/*
!reports/.gitkeep
!reports/*.md
# Explicit inventory path (also covered by !reports/*.md)
!reports/kaggle_data_inventory.md

# Pipeline artifacts (submission.csv, metrics.json, plots, model.pt)
outputs/

# Private row-level report labels (never commit, even outside outputs/)
weak_labels.csv
gold_predictions.csv
language_assignments.csv
mask_high_conf_positive.csv
mask_high_conf_negative.csv
mask_unknown.csv
mask_disagreement.csv
mask_unsupported_language.csv
gold_second_reader_predictions.csv
gold_consensus_predictions.csv
gold_deterministic_predictions.csv
gold_second_reader_status.csv

# Generated Kaggle source bundles (never commit)
*.zip
dist/
bundles/
kaggle_working/

# Local caches, predictions, experiment dumps
cache/
caches/
.cache/
predictions/
runs/
weights/

# Credentials
.env
.env.*
*.pem
*.key
kaggle.json
.kaggle/
secrets/

# Model checkpoints and serialised weights
*.ckpt
*.pt
*.pth
*.h5
*.hdf5
*.onnx
*.safetensors
*.pkl
*.joblib
checkpoints/
wandb/
mlruns/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/
